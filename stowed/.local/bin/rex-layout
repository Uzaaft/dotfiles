#!/usr/bin/env python3

"""Save/restore local Rex layouts, directories, and commands recorded by zsh.

Floating panes and scrollback are omitted. Restore re-runs recorded commands.
"""

import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile


def api(method, args=None):
    result = subprocess.run(
        ['rex', '--autostart=false', 'api', 'call', method, json.dumps(args or {})],
        capture_output=True, text=True, check=True,
    )
    return json.loads(result.stdout)


def snapshot_file():
    return Path(os.environ.get('XDG_STATE_HOME') or Path.home() / '.local/state') / 'rex-layout/snapshot.json'


def write_snapshot(file, snapshot):
    file.parent.mkdir(parents=True, exist_ok=True)
    fd, temp = tempfile.mkstemp(prefix='.rex-layout.', dir=file.parent)
    try:
        with os.fdopen(fd, 'w') as stream:
            json.dump(snapshot, stream, indent=2)
            stream.write('\n')
        os.replace(temp, file)
    finally:
        if os.path.exists(temp):
            os.unlink(temp)


def layout(node, blocks):
    if node.get('block_id') is not None:
        return blocks[node['block_id']]
    split = node['split']
    return {'split': {
        'direction': split['direction'], 'ratio': split['ratio'],
        'before': layout(split['before'], blocks),
        'after': layout(split['after'], blocks),
    }}


def check_directories(tree):
    if 'block' in tree:
        options = tree['block'].get('options', {})
        if 'initial_input' in options and not Path(options['cwd']).is_dir():
            raise ValueError(f"Command directory is missing: {options['cwd']}")
    else:
        check_directories(tree['split']['before'])
        check_directories(tree['split']['after'])


def save(file):
    host = api('server.status')['host_id']
    sessions = []
    flavor = 'com.superlogical.terminal.shell'
    for session in api('session.list')['sessions']:
        windows = []
        for window in api('session.view', {'session_id': session['session_id']})['windows']:
            tiled = [layer for layer in window['layers'] if layer['kind'] == 'tiled' and layer.get('layout')]
            blocks = {}
            for layer in tiled:
                for block in layer.get('blocks', []):
                    process = {}
                    if block['flavor'] == flavor and block['host_id'] == host:
                        process = api('block.method', {
                            'session_id': session['session_id'], 'block_id': block['block_id'],
                            'method': 'process', 'args': {},
                        })
                    record = snapshot_file().parent / 'running' / f"{block['block_id']}.json"
                    try:
                        running = json.loads(record.read_text())
                    except (OSError, ValueError):
                        running = None
                    child = process.get('child') or {}
                    foreground = process.get('foreground') or {}
                    pids = [child.get('pid'), foreground.get('pid')]
                    pids.extend(p.get('pid') for p in process.get('ancestors') or [])
                    replay = running and running['pid'] in pids and block['block_id'] != os.environ.get('REX_BLOCK')
                    options = {'cwd': running['cwd'] if replay else foreground.get('cwd') or child.get('cwd') or ''}
                    if replay:
                        # Bracketed paste preserves literal text against shell keybindings.
                        options.update(shell=running['shell'], initial_input='\x1b[200~' + running['command'] + '\x1b[201~\r')
                    blocks[block['block_id']] = {'block': {
                        'flavor': flavor, 'label': block['label'], 'options': options,
                    }}
            tree = layout(tiled[0]['layout'], blocks) if tiled else {'block': {'flavor': flavor}}
            saved = {'layout': tree}
            if not re.fullmatch(r'Window [0-9a-f]{8}', window['label']):
                saved['window_label'] = window['label']
            windows.append(saved)
        if windows:
            sessions.append({'ids': [session['session_id']], 'label': session['label'], 'initial_windows': windows})
    if not sessions:
        print('Nothing to save')
        return
    write_snapshot(file, {'host_id': host, 'sessions': sessions})
    print(f'Saved {len(sessions)} sessions to {file}')


def restore(file, dry_run):
    snapshot = json.loads(file.read_text())
    if snapshot['host_id'] != api('server.status')['host_id']:
        raise ValueError('Snapshot belongs to another Rex host')
    live = {session['session_id'] for session in api('session.list')['sessions']}
    for session in snapshot['sessions']:
        if live.intersection(session['ids']):
            print(f"Skipped {session['label']}")
        elif dry_run:
            print(f"Would restore {session['label']}")
        else:
            for window in session['initial_windows']:
                check_directories(window['layout'])
            created = api('session.create', {key: session[key] for key in ('label', 'initial_windows')})
            session['ids'].append(created['session_id'])
            write_snapshot(file, snapshot)
            print(f"Restored {session['label']}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='action', required=True)
    for action in ('save', 'restore'):
        command = commands.add_parser(action)
        command.add_argument('file', nargs='?', type=Path, default=snapshot_file())
        if action == 'restore':
            command.add_argument('-n', '--dry-run', action='store_true')
    args = parser.parse_args()
    try:
        if args.action == 'save':
            save(args.file.expanduser())
        else:
            restore(args.file.expanduser(), args.dry_run)
    except subprocess.CalledProcessError as error:
        sys.exit(error.stderr.strip())
    except (OSError, ValueError) as error:
        sys.exit(str(error))


if __name__ == '__main__':
    main()
